# syntax=docker/dockerfile:1.7

# BGX Navigation Dashboard — Django 6 + Django Ninja runtime (PARALLEL build).
#
# Added by task F1 of the Django rewrite. This file is SEPARATE from the
# existing ./Dockerfile so the frozen FastAPI app keeps building/deploying
# unchanged as the parity oracle until task I1 (decision I3-arch=A). Nothing
# under backend/ or the original Dockerfile is modified.
#
#   Stage 1 (node)   : builds the Astro SSG frontend — IDENTICAL to the
#                       original Dockerfile's Stage 1 (frontend untouched by
#                       design; both from-scratch and PREBUILT_DIST modes).
#   Stage 2 (python) : Django runtime — runs `manage.py migrate`, then boots
#                       gunicorn with a uvicorn ASGI worker (decision OV2=B:
#                       gunicorn retained, ASGI worker swap) serving the
#                       NinjaAPI + /health + (later) the X1 static catch-all.
#
# Build it via:  ./scripts/build-image.sh <tag> django
#                (or: docker build -f Dockerfile.django -t <tag> .)

###############################################################################
# Stage 1 — frontend build  (verbatim from ./Dockerfile — frontend unchanged)
###############################################################################
FROM node:20-alpine AS frontend

ARG API_URL=http://host.docker.internal:5001
ARG PREBUILT_DIST=0
ARG SITE=https://hardendurobulgaria.com
ENV API_URL=${API_URL} \
    SITE=${SITE} \
    NODE_ENV=production

WORKDIR /work

COPY frontend/package.json frontend/package-lock.json ./
RUN if [ "$PREBUILT_DIST" != "1" ]; then npm ci --no-audit --no-fund; fi

COPY frontend/ ./
RUN if [ "$PREBUILT_DIST" = "1" ]; then \
      echo "Using pre-built dist/ from build context"; \
      test -d dist && [ -n "$(ls -A dist 2>/dev/null)" ] \
        || { echo "ERROR: PREBUILT_DIST=1 but frontend/dist is missing or empty"; exit 1; }; \
    else \
      echo "Building Astro from scratch against API at ${API_URL}"; \
      npm run build; \
    fi

###############################################################################
# Stage 2 — Django (Ninja) runtime
###############################################################################
FROM python:3.12-slim AS runtime

LABEL version="0.1.0"
LABEL description="BGX Hard Enduro Championship Dashboard (Django 6 + Django Ninja + Astro SSG)"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=5001 \
    HOST=0.0.0.0 \
    DJANGO_SETTINGS_MODULE=config.settings \
    FRONTEND_DIST=/app/frontend_dist

WORKDIR /app

# curl kept for Docker/Railway healthchecks (same as the FastAPI image).
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Python deps. Pinned to the set verified in F1 (see django_app/pyproject.toml).
# psycopg[binary] ships its own libpq; gunicorn retained per decision OV2=B.
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
        "django>=6.0,<7.0" \
        "django-ninja>=1.3" \
        "psycopg[binary]>=3.2" \
        "gunicorn>=21.0.0" \
        "uvicorn[standard]>=0.27" \
        "python-dotenv>=1.0" \
        "dj-database-url>=2.2"

# Django source (side-by-side; backend/ is intentionally NOT copied here —
# this image runs the new app only). manage.py adds the package root to
# sys.path so config/core/api import cleanly with WORKDIR=/app.
COPY django_app/ ./

# Frontend build output (same target path as the FastAPI image so the X1
# static catch-all resolves FRONTEND_DIST=/app/frontend_dist identically).
COPY --from=frontend /work/dist ./frontend_dist

EXPOSE 5001

# Apply migrations, then boot gunicorn with the uvicorn ASGI worker.
# Railway re-runs this on every deploy. Single worker keeps the in-process
# analytics-salt cache (S6) coherent — matches the FastAPI single-process
# model; scale via Railway replicas, not gunicorn workers, unless S6's cache
# is made cross-process.
CMD ["sh", "-c", "python manage.py migrate --noinput && exec gunicorn config.asgi:application -k uvicorn.workers.UvicornWorker --bind ${HOST:-0.0.0.0}:${PORT:-5001} --workers 1 --timeout 60"]
