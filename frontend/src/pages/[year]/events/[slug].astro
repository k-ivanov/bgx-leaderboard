---
// RaceOverviewView — /{year}/events/{slug}
// See design-review.md §4.4.

import BaseLayout from '~/layouts/BaseLayout.astro';
import { copy } from '~/lib/copy';
import { formatDateLong } from '~/lib/format';
import { api } from '~/lib/api';

export async function getStaticPaths() {
  const seasons = await api.listSeasons();
  const paths: { params: { year: string; slug: string } }[] = [];
  for (const s of seasons.seasons) {
    const races = await api.listRaces(s.year);
    for (const ev of races.events) {
      paths.push({ params: { year: String(s.year), slug: ev.slug } });
    }
  }
  return paths;
}

const { year, slug } = Astro.params;
const yearNum = Number(year);

const [seasonsOut, races, detail] = await Promise.all([
  api.listSeasons(),
  api.listRaces(yearNum),
  api.getRace(yearNum, slug!),
]);
const allYears = seasonsOut.seasons.map(s => s.year);

const round = races.events.findIndex(e => e.slug === slug) + 1;
const locationFull = detail.event.location
  ? `${detail.event.location}, Bulgaria`
  : 'Bulgaria';
const dateLong = formatDateLong(detail.event.event_date);

const title = copy.seo.raceOverviewTitle(detail.event.name, round, yearNum);
const description = copy.seo.raceOverviewDescription(
  round,
  yearNum,
  detail.event.name,
  detail.event.location,
  detail.event.event_date ? dateLong : null,
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: detail.event.name,
  startDate: detail.event.event_date ?? undefined,
  endDate: detail.event.event_date ?? undefined,
  location: {
    '@type': 'Place',
    name: locationFull,
  },
  sport: 'Hard Enduro',
  superEvent: {
    '@type': 'SportsEvent',
    name: `${yearNum} BGX Hard Enduro Championship`,
  },
  url: Astro.url.href,
};
---
<BaseLayout
  title={title}
  description={description}
  year={yearNum}
  activeYear={yearNum}
  allYears={allYears}
  currentNav="races"
  jsonLd={jsonLd}
>
  <section class="page-header mb-8">
    <h1 class="text-2xl md:text-[32px] font-extrabold tracking-[-0.02em]">
      {copy.raceOverview.h1(detail.event.name)}
    </h1>
    <p class="mt-2 text-[15px] text-fg-muted">
      {copy.raceOverview.subtitleFmt(round, dateLong, locationFull)}
    </p>
  </section>

  <section>
    <h2 class="mb-4 text-lg font-bold tracking-[-0.01em]">
      {copy.raceOverview.sectionResults}
    </h2>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
      {detail.categories.map(c => (
        <a
          href={`/${yearNum}/${c.code}/${slug}`}
          class="rounded-[10px] border border-border bg-bg-elevated px-4 py-4 transition-colors hover:border-accent"
        >
          <div class="text-[11px] font-semibold uppercase tracking-[0.08em] text-fg-faint">
            {c.display_name}
          </div>
          <div class="mt-1 text-lg font-semibold text-fg">
            {copy.raceOverview.viewResults}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
