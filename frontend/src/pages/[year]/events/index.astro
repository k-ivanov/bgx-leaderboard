---
// RacesView — /{year}/events
// See design-review.md §4.2.

import BaseLayout from '~/layouts/BaseLayout.astro';
import EmptyState from '~/components/common/EmptyState.astro';
import { copy } from '~/lib/copy';
import { formatDateShort, isPast } from '~/lib/format';
import { api } from '~/lib/api';

export async function getStaticPaths() {
  const seasons = await api.listSeasons();
  return seasons.seasons.map(s => ({ params: { year: String(s.year) } }));
}

const { year } = Astro.params;
const yearNum = Number(year);
const [seasonsOut, races] = await Promise.all([
  api.listSeasons(),
  api.listRaces(yearNum),
]);
const allYears = seasonsOut.seasons.map(s => s.year);
const events = races.events;

const now = new Date();
const completed = events.filter(e => isPast(e.event_date, now)).length;
const upcoming = events.length - completed;

const title = `${yearNum} Races · BGX Hard Enduro Championship`;
const description = `${yearNum} race calendar for the BGX Hard Enduro Championship. ${events.length} races${events.length > 0 ? ` from ${events[0].name} to ${events[events.length - 1].name}` : ''}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: `${yearNum} BGX Hard Enduro Championship`,
  sport: 'Hard Enduro',
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'Country', name: 'Bulgaria' },
  url: Astro.url.href,
};
---
<BaseLayout
  title={title}
  description={description}
  year={yearNum}
  activeYear={yearNum}
  allYears={allYears}
  currentNav="races"
  jsonLd={jsonLd}
>
  <section class="page-header mb-8">
    <h1 class="text-2xl md:text-[32px] font-extrabold tracking-[-0.02em]">
      {copy.races.h1(yearNum)}
    </h1>
    <p class="mt-2 text-[15px] text-fg-muted">
      {copy.races.subtitleFmt(events.length, upcoming, completed)}
    </p>
  </section>

  {events.length === 0 ? (
    <EmptyState message={copy.races.empty(yearNum)} />
  ) : (
    <div class="card overflow-hidden rounded-xl border border-border bg-bg-elevated">
      <div class="scrollx">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-bg-muted">
              <th class="text-fg-faint text-[11px] font-semibold uppercase tracking-[0.06em] px-3 py-3 text-center border-b border-border">{copy.races.colHash}</th>
              <th class="text-fg-faint text-[11px] font-semibold uppercase tracking-[0.06em] px-3 py-3 text-left border-b border-border">{copy.races.colRace}</th>
              <th class="text-fg-faint text-[11px] font-semibold uppercase tracking-[0.06em] px-3 py-3 text-left border-b border-border">{copy.races.colLocation}</th>
              <th class="text-fg-faint text-[11px] font-semibold uppercase tracking-[0.06em] px-3 py-3 text-center border-b border-border">{copy.races.colDate}</th>
              <th class="text-fg-faint text-[11px] font-semibold uppercase tracking-[0.06em] px-3 py-3 text-center border-b border-border">{copy.races.colStatus}</th>
            </tr>
          </thead>
          <tbody>
            {events.map((ev, idx) => {
              const past = isPast(ev.event_date, now);
              return (
                <tr class:list={[
                  'hover:bg-[rgba(245,158,11,0.03)] border-b border-border-muted',
                  past && 'text-fg-muted',
                ]}>
                  <td class="px-3 py-3.5 text-center mono text-fg-faint">{(idx + 1).toString().padStart(2, '0')}</td>
                  <td class="px-3 py-3.5">
                    <a href={`/${yearNum}/events/${ev.slug}`} class="font-medium hover:text-accent">
                      {ev.name}
                    </a>
                  </td>
                  <td class="px-3 py-3.5">{ev.location ?? '—'}</td>
                  <td class="px-3 py-3.5 text-center mono">{formatDateShort(ev.event_date)}</td>
                  <td class="px-3 py-3.5 text-center text-xs">
                    {past ? copy.races.statusCompleted : copy.races.statusUpcoming}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  )}
</BaseLayout>
