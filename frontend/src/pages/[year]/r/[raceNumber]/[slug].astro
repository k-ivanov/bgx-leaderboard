---
// RiderView (singular) — /{year}/r/{raceNumber}/{slug}
// See design-review.md §4.5.

import BaseLayout from '~/layouts/BaseLayout.astro';
import PositionBadge from '~/components/common/PositionBadge.astro';
import PointsPill from '~/components/common/PointsPill.astro';
import TimeCell from '~/components/common/TimeCell.astro';
import EmptyState from '~/components/common/EmptyState.astro';
import { copy } from '~/lib/copy';
import { formatDateShort, ordinal } from '~/lib/format';
import { api } from '~/lib/api';

export async function getStaticPaths() {
  const seasons = await api.listSeasons();
  const paths: { params: { year: string; raceNumber: string; slug: string } }[] = [];
  for (const s of seasons.seasons) {
    // Find every (race_number, first, last) pair via the leaderboards
    // (cheaper than walking every category's riders endpoint).
    const seen = new Set<string>();
    const detail = await api.getSeason(s.year);
    for (const c of detail.categories) {
      const lb = await api.getLeaderboard(s.year, c.code);
      for (const row of lb.rows) {
        const key = `${row.rider.race_number}|${row.rider.slug}`;
        if (seen.has(key)) continue;
        seen.add(key);
        paths.push({
          params: {
            year: String(s.year),
            raceNumber: String(row.rider.race_number),
            slug: row.rider.slug,
          },
        });
      }
    }
  }
  return paths;
}

const { year, raceNumber, slug } = Astro.params;
const yearNum = Number(year);
const raceNum = Number(raceNumber);

const [seasonsOut, profile] = await Promise.all([
  api.listSeasons(),
  api.getRiderProfile(yearNum, raceNum, slug!),
]);
const allYears = seasonsOut.seasons.map(s => s.year);

const rider = profile.rider;
const bestFinish = profile.results.reduce<number | null>((best, r) => {
  if (r.position == null) return best;
  if (best == null || r.position < best) return r.position;
  return best;
}, null);
const totalPoints = profile.results.reduce(
  (sum, r) => sum + (r.points ?? 0),
  0,
);
const racesEntered = new Set(profile.results.map(r => r.event.slug)).size;
const primaryCategory = profile.categories[0];

const title = copy.seo.riderTitle(
  rider.first_name,
  rider.last_name,
  primaryCategory?.display_name ?? copy.common.rider,
  yearNum,
);
const description = copy.seo.riderDescription(
  rider.first_name,
  rider.last_name,
  rider.race_number,
  primaryCategory?.display_name ?? copy.common.rider,
  bestFinish ? ordinal(bestFinish) : '—',
  racesEntered,
  yearNum,
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: `${rider.first_name} ${rider.last_name}`,
  jobTitle: 'Enduro rider',
  affiliation: rider.team
    ? { '@type': 'SportsTeam', name: rider.team }
    : undefined,
  url: Astro.url.href,
  identifier: String(rider.race_number),
};

// Group results by category for per-section rendering.
const byCategory = new Map<string, typeof profile.results>();
for (const r of profile.results) {
  const key = r.category.code;
  if (!byCategory.has(key)) byCategory.set(key, []);
  byCategory.get(key)!.push(r);
}
---
<BaseLayout
  title={title}
  description={description}
  year={yearNum}
  activeYear={yearNum}
  allYears={allYears}
  currentNav="rider"
  jsonLd={jsonLd}
  trackPage="rider"
  trackRiderSlug={`${raceNum}-${slug}`}
>
  <section class="mb-8 rounded-xl border border-border bg-bg-elevated p-5 md:p-6">
    <div class="flex flex-wrap items-baseline gap-4">
      <span class="rounded-md bg-bg-muted px-3 py-1.5 text-lg font-extrabold mono">
        #{rider.race_number}
      </span>
      <h1 class="text-2xl md:text-[32px] font-extrabold tracking-[-0.02em]">
        {`${rider.first_name} ${rider.last_name}`}
      </h1>
    </div>
    <p class="mt-2 text-[15px] text-fg-muted">
      {copy.rider.metaFmt(rider.team, rider.bike, primaryCategory?.display_name ?? '')}
    </p>
    <p class="mt-3 text-sm text-fg-muted">
      {copy.rider.statsFmt(
        bestFinish ? ordinal(bestFinish) : '—',
        racesEntered,
        totalPoints % 1 === 0 ? totalPoints : Number(totalPoints.toFixed(1)),
      )}
    </p>
  </section>

  {profile.results.length === 0 ? (
    <EmptyState message={copy.rider.empty(yearNum)} />
  ) : (
    [...byCategory.entries()].map(([code, items]) => {
      const cat = profile.categories.find(c => c.code === code);
      const catName = cat?.display_name ?? code;
      return (
        <section class="mb-10">
          <h2 class="mb-3 text-lg font-bold tracking-[-0.01em]">
            {copy.rider.sectionSeasonResults(catName)}
          </h2>
          <div class="card overflow-hidden rounded-xl border border-border bg-bg-elevated">
            <div class="scrollx">
              <table class="w-full text-sm">
                <thead>
                  <tr class="bg-bg-muted">
                    <th class="text-fg-faint text-[11px] font-semibold uppercase tracking-[0.06em] px-3 py-3 text-left border-b border-border">{copy.rider.colRound}</th>
                    <th class="text-fg-faint text-[11px] font-semibold uppercase tracking-[0.06em] px-3 py-3 text-left border-b border-border">{copy.rider.colRace}</th>
                    <th class="text-fg-faint text-[11px] font-semibold uppercase tracking-[0.06em] px-3 py-3 text-center border-b border-border">{copy.rider.colDate}</th>
                    <th class="text-fg-faint text-[11px] font-semibold uppercase tracking-[0.06em] px-3 py-3 text-center border-b border-border">{copy.rider.colPosition}</th>
                    <th class="text-fg-faint text-[11px] font-semibold uppercase tracking-[0.06em] px-3 py-3 text-right border-b border-border">{copy.rider.colPoints}</th>
                    <th class="text-fg-faint text-[11px] font-semibold uppercase tracking-[0.06em] px-3 py-3 text-right border-b border-border">{copy.rider.colTime}</th>
                  </tr>
                </thead>
                <tbody>
                  {items.map((r, idx) => (
                    <tr class="hover:bg-[rgba(245,158,11,0.03)] border-b border-border-muted">
                      <td class="px-3 py-3 text-fg-faint mono">R{idx + 1}</td>
                      <td class="px-3 py-3">
                        <a href={`/${yearNum}/${code}/${r.event.slug}`} class="hover:text-accent">
                          {r.event.name}
                        </a>
                      </td>
                      <td class="px-3 py-3 text-center mono text-fg-muted">{formatDateShort(r.event.event_date)}</td>
                      <td class="px-3 py-3 text-center">
                        <PositionBadge position={r.position} />
                      </td>
                      <td class="px-3 py-3 text-right"><PointsPill points={r.points} /></td>
                      <td class="px-3 py-3 text-right"><TimeCell ms={r.time_ms} /></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>
      );
    })
  )}

  <p class="mt-8 text-sm">
    {primaryCategory && (
      <a href={`/${yearNum}/${primaryCategory.code}`} class="text-fg-muted hover:text-accent">
        {copy.rider.backToCategory(primaryCategory.display_name)}
      </a>
    )}
  </p>
</BaseLayout>
