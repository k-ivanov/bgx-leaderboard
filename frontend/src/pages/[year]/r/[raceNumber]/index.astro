---
// RiderView (disambiguation) — /{year}/r/{raceNumber}
// Rendered when multiple (first, last) pairs share a race number.
// For numbers with only one rider, we redirect straight to the singular page.
// See design-review.md §4.5.

import BaseLayout from '~/layouts/BaseLayout.astro';
import { copy } from '~/lib/copy';
import { api } from '~/lib/api';

export async function getStaticPaths() {
  const seasons = await api.listSeasons();
  const paths: { params: { year: string; raceNumber: string } }[] = [];
  for (const s of seasons.seasons) {
    // Collect every race_number appearing in any leaderboard this season.
    const seen = new Set<number>();
    const detail = await api.getSeason(s.year);
    for (const c of detail.categories) {
      const lb = await api.getLeaderboard(s.year, c.code);
      for (const row of lb.rows) {
        seen.add(row.rider.race_number);
      }
    }
    for (const n of seen) {
      paths.push({
        params: { year: String(s.year), raceNumber: String(n) },
      });
    }
  }
  return paths;
}

const { year, raceNumber } = Astro.params;
const yearNum = Number(year);
const raceNum = Number(raceNumber);

const disambig = await api.getRiderDisambiguation(yearNum, raceNum);
const seasonsOut = await api.listSeasons();
const allYears = seasonsOut.seasons.map(s => s.year);

// If only one rider matches, send the user straight to their profile.
// The slug may contain Cyrillic characters — HTTP Location headers must be
// ASCII (ByteString), so percent-encode the slug in the redirect target.
if (disambig.candidates.length === 1) {
  return Astro.redirect(
    `/${yearNum}/r/${raceNum}/${encodeURIComponent(disambig.candidates[0].rider.slug)}`,
    302,
  );
}

const title = copy.seo.riderDisambigTitle(raceNum, yearNum);
const description = copy.seo.riderDisambigDescription(
  disambig.candidates.length,
  raceNum,
  yearNum,
);
---
<BaseLayout
  title={title}
  description={description}
  noindex
  year={yearNum}
  activeYear={yearNum}
  allYears={allYears}
  currentNav="rider"
  trackPage="other"
>
  <section class="page-header mb-6">
    <h1 class="text-2xl md:text-[32px] font-extrabold tracking-[-0.02em]">
      {copy.rider.disambigH1(raceNum, yearNum)}
    </h1>
    <p class="mt-2 text-[15px] text-fg-muted">
      {copy.rider.disambigHelp(disambig.candidates.length, raceNum)}
    </p>
  </section>

  <ul role="list" class="space-y-3">
    {disambig.candidates.map(c => (
      <li>
        <a
          href={`/${yearNum}/r/${c.rider.race_number}/${c.rider.slug}`}
          class="block rounded-xl border border-border bg-bg-elevated p-5 transition-colors hover:border-accent"
        >
          <div class="flex items-baseline gap-3">
            <span class="rounded-md bg-bg-muted px-2.5 py-1 text-sm font-bold mono">
              #{c.rider.race_number}
            </span>
            <span class="text-lg font-semibold">
              {`${c.rider.first_name} ${c.rider.last_name}`}
            </span>
          </div>
          <div class="mt-2 text-sm text-fg-muted">
            {[c.rider.team, c.categories.map(k => k.display_name).join(', ')]
              .filter(Boolean)
              .join(' · ')}
          </div>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
