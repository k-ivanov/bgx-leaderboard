---
// /{year}/ — redirect to the first category for that year.
import { api } from '~/lib/api';

export async function getStaticPaths() {
  const seasons = await api.listSeasons();
  return seasons.seasons.map(s => ({ params: { year: String(s.year) } }));
}

const { year } = Astro.params;
const yearNum = Number(year);
const detail = await api.getSeason(yearNum);
const first = detail.categories[0];
return Astro.redirect(first ? `/${year}/${first.code}` : `/`, 302);
---
