DATABASE_URL=postgresql+psycopg2://bgx:bgx@localhost:5432/bgx
DEFAULT_SEASON_YEAR=2026
PORT=5001
HOST=0.0.0.0

# /stats HTTP Basic gate — empty disables auth (any caller can fetch).
# `make dev-backend` sets this to 'letmein' if unset; in Railway, set a real value.
STATS_PASSWORD=letmein

# Admin panel (SQLAdmin) — empty disables /admin entirely (returns 403).
# `make dev-backend` defaults this to 'letmein' too.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=letmein

# Google Maps JavaScript API key for the /races map.
# This is consumed by the FRONTEND build (Astro), not the backend — it gets
# baked into the static HTML at `npm run build` time as
# PUBLIC_GOOGLE_MAPS_API_KEY. Set it on the build environment (release.yml
# secret + GHA env block) or in `frontend/.env` for local dev. Restrict the
# key by HTTP referrer in Google Cloud Console (allow only your domain).
# When unset, /races falls back to the stylized SVG silhouette map.
GOOGLE_MAPS_API_KEY=
