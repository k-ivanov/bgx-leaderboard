DATABASE_URL=postgresql+psycopg2://bgx:bgx@localhost:5432/bgx
DEFAULT_SEASON_YEAR=2026
PORT=5001
HOST=0.0.0.0

# /stats HTTP Basic gate — empty disables auth (any caller can fetch).
# `make dev-backend` sets this to 'letmein' if unset; in Railway, set a real value.
STATS_PASSWORD=letmein

# Admin panel (SQLAdmin) — empty disables /admin entirely (returns 403).
# `make dev-backend` defaults this to 'letmein' too.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=letmein
